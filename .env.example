# Naslai — переменные окружения бэкенда.
# Скопируйте в .env и заполните. Настоящие ключи в git не кладите.

# ====================================================================
#  Django и безопасность
# ====================================================================

# Обязателен при DJANGO_DEBUG=0 — без него сервер не запустится.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# 1 — локальная разработка, 0 — боевой сервер.
# ВАЖНО: по умолчанию 0. Забытый DEBUG=1 на сервере показывает всем
# страницу ошибки с этим файлом целиком: ключи, пароли, всё.
DJANGO_DEBUG=0

# Домен сервиса. Отсюда считаются список хостов, CORS и CSRF.
NASLAI_SITE_DOMAIN=naslai.uz

# На какие имена отвечаем. Пусто = naslai.uz, www.naslai.uz, api.naslai.uz
# (плюс localhost — он нужен nginx и проверкам доступности).
DJANGO_ALLOWED_HOSTS=naslai.uz,www.naslai.uz

# Кому браузер разрешит читать наши ответы, СВЕРХ https://naslai.uz и
# https://www.naslai.uz. Оставьте пустым. Каждый адрес здесь получает
# доступ к сессиям вошедших людей — добавляйте, только если понимаете,
# зачем (например, отдельный стенд).
DJANGO_CORS_EXTRA_ORIGINS=

# Общий домен cookie. Нужен ТОЛЬКО если сайт на naslai.uz, а API вынесен
# на api.naslai.uz. При одном домене оставьте пустым.
DJANGO_COOKIE_DOMAIN=
# И тогда же — абсолютные адреса картинок.
NASLAI_ABSOLUTE_MEDIA_URLS=0

# Адрес админки. /admin/ перебирают ботами круглосуточно.
DJANGO_ADMIN_PATH=admin

# Перенаправление на HTTPS. Обычно это делает nginx — тогда оставьте 0.
DJANGO_SECURE_SSL_REDIRECT=0
# HSTS. Включайте, только когда HTTPS уже работает на всех поддоменах:
# браузер запомнит правило на год, и откатиться нельзя.
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0

# Ограничение частоты запросов — защита от подбора пароля и от накрутки
# платных вызовов.
THROTTLE_ANON=60/min
THROTTLE_USER=240/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=20/hour
THROTTLE_PROMO=10/hour
THROTTLE_GENERATION=30/hour
THROTTLE_AUDIT=20/hour
THROTTLE_ANALYZE=60/hour

# Предел размера запроса. Фото приходят строкой base64 внутри JSON.
DJANGO_MAX_BODY_BYTES=20971520

# --- Очередь генерации ----------------------------------------------
# ПУСТО = генерация идёт прямо в запросе (локальная разработка, тесты).
# На боевом сервере ЗАПОЛНИТЕ — иначе рабочие процессы gunicorn будут
# заняты по три минуты каждый, и сайт замрёт для всех остальных.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Предел на одну задачу. Пакет из пяти картинок идёт до пятнадцати минут.
CELERY_SOFT_TIME_LIMIT=1200
CELERY_TIME_LIMIT=1500
# Через сколько минут задача считается зависшей (release_stuck_jobs).
STUCK_JOB_MINUTES=30

DJANGO_TIME_ZONE=Asia/Tashkent
DJANGO_LOG_LEVEL=INFO

# База вне папки с кодом: иначе выкладка новой версии может её затереть.
NASLAI_DB_PATH=/var/lib/naslai/db.sqlite3
# Картинки — туда, где есть бэкап.
NASLAI_MEDIA_ROOT=/var/lib/naslai/media
DJANGO_STATIC_ROOT=/var/lib/naslai/static


# ====================================================================
#  Генерация
# ====================================================================
# mock — заглушка без затрат. Начинайте с неё.
# openai — реальная генерация.
GENERATION_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_BRIEF_MODEL=gpt-4o
OPENAI_BRIEF_TIMEOUT_MS=60000
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
# PNG — источник без потерь. В JPEG сжимаем один раз, уже у себя.
OPENAI_IMAGE_OUTPUT_FORMAT=png
DELIVERED_JPEG_QUALITY=96
OPENAI_IMAGE_TIMEOUT_MS=180000
OPENAI_IMAGE_RETRY_DELAY_MS=15000

MAX_JOBS_PER_USER=50


# ====================================================================
#  Аудит «Плохие продажи?»
# ====================================================================
AUDIT_PROVIDER=mock
AUDIT_FREE_PER_DAY=3


# ====================================================================
#  Вход через Google и Telegram
# ====================================================================
# Пусто = кнопка не показывается.
#
# Google: console.cloud.google.com → APIs & Services → Credentials →
#   OAuth client ID → Web application. В origins добавьте https://naslai.uz
#   Client ID публичный, секрет не нужен.
GOOGLE_CLIENT_ID=

# Telegram: @BotFather → создать бота → /setdomain → naslai.uz
#   Токен бота — секрет.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=


# ====================================================================
#  Экономика
# ====================================================================
# Цены считаются отсюда. Проверьте курс перед изменением.
API_IMAGE_COST_USD=0.05
USD_UZS=11935
RETRY_RATE=0.10
PAYMENT_LOAD=0.025
TARGET_MARGIN=0.768

# Бесплатные токены. Для входа по почте — ноль: одноразовый ящик
# делается за десять секунд, через него и накручивали генерации.
STARTER_TOKENS=2
STARTER_TOKENS_UNVERIFIED=0

# Онлайн-оплата. Включать ТОЛЬКО вместе с обработчиком уведомлений
# Click/Payme: токены нельзя начислять до подтверждения провайдера.
PAYMENTS_ENABLED=0
PAYMENT_PROVIDERS=click,payme


# ====================================================================
#  Прочее
# ====================================================================
# Кто видит админку. Пусто = закрыта для всех.
ADMIN_EMAILS=
MAX_API_KEYS_PER_USER=3
# 1 — не проверять MX-запись почты (для локальной разработки без DNS).
SKIP_EMAIL_MX_CHECK=0
